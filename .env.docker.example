# ============================================================
#  bluemoon Docker 部署配置模板
#
#  用法：
#    1) 复制到仓库根目录并命名为 .env
#         Windows : copy .env.docker.example .env
#         Linux   : cp .env.docker.example .env
#       或者直接运行 scripts/docker-up.sh（会自动生成 .env 并填入随机值）
#    2) 至少填写下面三个「必填」项
#    3) 启动：docker compose up -d --build
#
#  说明：
#    - compose 只把本文件当作「变量插值来源」，不会自动注入容器；
#      容器实际拿到的值由 docker-compose.yml 的 environment 段决定。
#    - .env 已被 .gitignore 忽略，不会被提交，也不会进镜像
#      （.dockerignore 里也显式排除了）。
# ============================================================

# ---------------- 访问端口 ----------------
# 浏览器访问 http://localhost:8000 ；改成 80 即可直接访问 http://localhost
API_PORT=8000

# ---------------- 运行模式 ----------------
# production：关闭 /docs、/redoc、/openapi.json，并强制校验 SECRET_KEY
# development：开放接口文档，便于排查
APP_ENV=production
DEBUG=false

# ---------------- 密钥【必填】----------------
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
# APP_ENV=production 时长度不足 32 位或为默认值，应用会拒绝启动。
SECRET_KEY=

# ---------------- MySQL【必填】----------------
MYSQL_DB=bluemoon
MYSQL_USER=bluemoon
# 业务账号密码（应用连接用）
MYSQL_PASSWORD=
# root 密码（首次建库 / 建业务账号用，之后仅容器内部使用）
MYSQL_ROOT_PASSWORD=

# ---------------- Redis ----------------
# 置 false 则完全不使用缓存（后端自动降级直连 MySQL）
REDIS_ENABLED=true

# ---------------- 数据库自动初始化 ----------------
# true：容器启动时幂等地建库/建表/灌演示数据（已有数据会跳过）
AUTO_INIT_DB=true

# ---------------- 时区 ----------------
TZ=Asia/Shanghai

# ---------------- 站点信息 ----------------
BLOG_TITLE=Bluemoon
BLOG_SUBTITLE=一个安静写字的地方
BLOG_DESCRIPTION=记录生活、技术与思考的个人博客
BLOG_AUTHOR=bluemoon

# ---------------- CORS ----------------
# 同源单入口部署下浏览器不会发跨域请求，这里只是兜底
CORS_ORIGINS=http://localhost:8000

# ---------------- 反向代理信任【默认留空】----------------
# 留空 = 不信任任何转发头，直连部署的正确默认值。
# 只有在前方再放一层反向代理（nginx / traefik / 云负载均衡）时才填，
# 且必须填该代理的地址，例如：172.18.0.2 或 172.18.0.0/16。
# 填错的后果：按 IP 的阅读去重与登录限流形同虚设（可被伪造 XFF 绕过）。
TRUSTED_PROXIES=
