@echo off
REM ============================================================
REM  本机路径覆盖（可选）
REM
REM  用法：复制本文件为同目录下的 local.env.bat，按本机实际情况修改。
REM  local.env.bat 已被 .gitignore 忽略，不会上传，可放心填本机路径。
REM  没有这个文件时，start-all.bat 会使用下面注释里的默认值。
REM
REM  注意：本文件必须保存为 ANSI/GBK 编码 + CRLF 换行
REM ============================================================

REM MySQL 8 解压/安装目录：其下必须同时存在 bin\mysqld.exe 与 my.ini
REM 默认值 D:\mysql8
set "MYSQL=D:\mysql8"

REM Node.js 安装目录：留空则直接使用系统 PATH 中的 node / npm
REM 路径含空格需要用引号包住
set "NODEBIN=C:\Program Files\nodejs"

REM Redis 目录：其下需有 redis-server.exe，留空则用 %BASE%\_tools\redis
REM set "REDIS=D:\redis"
