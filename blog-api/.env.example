# 复制本文件为 .env 后按实际环境修改
APP_NAME=bluemoon blog
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=bluemoon
MYSQL_PASSWORD=bluemoon123
MYSQL_DB=bluemoon
MYSQL_ECHO=false

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=true

CACHE_TTL_POST_DETAIL=600
CACHE_TTL_POST_LIST=300
CACHE_TTL_STATS=120

SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

UPLOAD_DIR=static/uploads
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_EXT=jpg,jpeg,png,gif,webp,bmp,svg

BLOG_TITLE=Bluemoon
BLOG_SUBTITLE=一个安静写字的地方
BLOG_DESCRIPTION=记录生活、技术与思考的个人博客
BLOG_AUTHOR=bluemoon
BLOG_ICP=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
