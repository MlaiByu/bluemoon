# 复制本文件为 .env 后按实际环境修改
APP_NAME=bluemoon blog
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=bluemoon
MYSQL_PASSWORD=bluemoon123
MYSQL_DB=bluemoon
MYSQL_ECHO=false

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=true

CACHE_TTL_POST_DETAIL=600
CACHE_TTL_POST_LIST=300
CACHE_TTL_STATS=120

# ⚠️ 不要用 "change-me"。生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# APP_ENV=production 时若密钥为默认值或长度 < 32，应用会拒绝启动（见 core/config.py 的校验）
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

UPLOAD_DIR=static/uploads
MAX_UPLOAD_SIZE=5242880
# 不要加 svg：/static 与站点同源托管，带脚本的 SVG 会变成存储型 XSS
ALLOWED_IMAGE_EXT=jpg,jpeg,png,gif,webp,bmp
# 图片像素上限（宽×高），防解压炸弹
IMAGE_MAX_PIXELS=50000000
CACHE_TTL_IMAGE_LIST=60

# 登录防爆破（同一 用户名+IP 在窗口内失败达上限后锁定）
LOGIN_MAX_FAILURES=5
LOGIN_FAIL_WINDOW_SECONDS=300
LOGIN_LOCK_SECONDS=300

# 反向代理白名单：只有来源 IP 在此列表内才采信 X-Forwarded-For。
# 直连部署务必留空，否则伪造 XFF 即可绕过按 IP 的去重与限流。
TRUSTED_PROXIES=

BLOG_TITLE=Bluemoon
BLOG_SUBTITLE=一个安静写字的地方
BLOG_DESCRIPTION=记录生活、技术与思考的个人博客
BLOG_AUTHOR=bluemoon
BLOG_ICP=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
